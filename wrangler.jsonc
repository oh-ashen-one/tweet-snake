{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tweet-snake",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/r/*", "/play/*", "/ws/*", "/api/*", "/auth/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ARENA", "class_name": "Arena" },
      { "name": "META", "class_name": "Meta" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Arena", "Meta"] }],
  "observability": { "enabled": true }
}
